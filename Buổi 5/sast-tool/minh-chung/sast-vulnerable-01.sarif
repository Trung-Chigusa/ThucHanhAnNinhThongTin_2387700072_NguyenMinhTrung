{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "PySAST",
          "version": "1.0.0",
          "informationUri": "https://github.com/",
          "rules": [
            {
              "id": "PY-EVAL",
              "name": "Use of eval",
              "shortDescription": {
                "text": "Use of eval"
              }
            },
            {
              "id": "PY-UNSAFE-DESERIALIZATION",
              "name": "Unsafe deserialization",
              "shortDescription": {
                "text": "Unsafe deserialization"
              }
            },
            {
              "id": "PY-HARDCODED-CREDENTIAL",
              "name": "Hardcoded credential",
              "shortDescription": {
                "text": "Hardcoded credential"
              }
            },
            {
              "id": "PY-PICKLE-IMPORT",
              "name": "Pattern Match",
              "shortDescription": {
                "text": "Pattern Match"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "PY-EVAL",
          "level": "error",
          "message": {
            "text": "Evaluates text as Python code."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/vulnerable_01.py"
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 12
                }
              }
            }
          ]
        },
        {
          "ruleId": "PY-UNSAFE-DESERIALIZATION",
          "level": "error",
          "message": {
            "text": "Deserializing untrusted data can execute code."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/vulnerable_01.py"
                },
                "region": {
                  "startLine": 13,
                  "startColumn": 12
                }
              }
            }
          ]
        },
        {
          "ruleId": "PY-HARDCODED-CREDENTIAL",
          "level": "warning",
          "message": {
            "text": "A credential-like value is assigned directly in source."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/vulnerable_01.py"
                },
                "region": {
                  "startLine": 5,
                  "startColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "PY-PICKLE-IMPORT",
          "level": "warning",
          "message": {
            "text": "Review pickle use; never load untrusted serialized data."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/vulnerable_01.py"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
